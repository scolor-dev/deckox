[Unit]
Description=Deckox isolated web terminal
Documentation=https://github.com/scolor-dev/deckox
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/deckox-terminal
Environment=DECKOX_TERMINAL_SOCKET=/run/deckox-terminal/terminal.sock
Environment=DECKOX_TERMINAL_ENABLED=true
Environment=DECKOX_TERMINAL_SHELL=/bin/sh
Environment=DECKOX_TERMINAL_HOME=/var/lib/deckox-terminal
Environment=RUST_LOG=deckox_terminal=info
User=deckox-terminal
Group=deckox-terminal
UMask=0007
RuntimeDirectory=deckox-terminal
RuntimeDirectoryMode=0770
WorkingDirectory=/var/lib/deckox-terminal
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/deckox-terminal
InaccessiblePaths=/run/deckox /var/lib/deckox /etc/deckox

[Install]
WantedBy=multi-user.target
